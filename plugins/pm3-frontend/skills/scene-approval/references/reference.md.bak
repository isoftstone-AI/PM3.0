# 审批页代码模板

> 基准代码来源：
> - 审批模板页面：`src/views/office/todo/components/apply-modal/startApplyApproval.tsx`
> - 审批表单组件：`src/views/office/todo/components/apply-modal/approval-form/StartApplyApprovalForm.tsx`
>
> 所有 `[REPLACE]` 标记的区域需要根据业务信息替换
> 所有 `[KEEP]` 标记的区域保持模板代码不变
> 所有 `[OPTIONAL]` 标记的区域根据需求决定是否保留
> 所有 `[NOTE]` 标记的区域需要特别注意

---

## Block 1: 审批模板页面 xxxApproval.tsx

```typescript
/**
 * [REPLACE] 业务模块名 审批模板
 * 复用 [REPLACE] 查看组件名 组件并提供审批操作
 */

import { defineComponent, ref, reactive, computed, onMounted, PropType, provide, watch, nextTick } from 'vue';
import InnerLayout from '@/layouts/innerLayout';
import { useMessage } from '@/hooks/web/useMessage';
import { useI18n } from '@/hooks/web/useI18n';

// [REPLACE] 业务相关导入
import { [REPLACE:详情API函数名] } from '[REPLACE:详情API导入路径]';
// [OPTIONAL] 如果有驳回重发回调，导入 updateStatusToApproving
// import { updateStatusToApproving } from '[REPLACE:驳回重发API导入路径]';
import [REPLACE:查看组件名], { type [REPLACE:查看组件Ref类型名] } from '[REPLACE:查看组件导入路径]';
// [NOTE] 如果查看组件和编辑组件是同一个（仅 mode 不同），只需导入一次
import [REPLACE:编辑组件名], { type [REPLACE:编辑组件Ref类型名] } from '[REPLACE:编辑组件导入路径]';
// [NOTE] 如果查看和编辑组件相同，删除上面这行
import [REPLACE:ApprovalForm组件名], { type [REPLACE:IApprovalForm类型名] } from './approval-form/[REPLACE:ApprovalForm文件名]';
import type { [REPLACE:详情类型名] } from '[REPLACE:详情类型导入路径]';

// [KEEP] 权限上下文
export enum ProvideContext {
  Permission = 'Permission',
}
export type PermissionData = {
  templatePermission: string;
  operationType: string;
  otherOperationType: string;
};

type DetailData = Partial<[REPLACE:详情类型名]>;

// [KEEP] props 定义
const props = {
  record: { type: [Object, null] as PropType<Record<string, any> | null>, default: () => null },
  applyName: { type: String, default: () => '' },
  modalType: { type: String as PropType<'approve' | 'approveRecord'>, default: () => 'approve' },
};

const [REPLACE:组件名] = defineComponent({
  name: '[REPLACE:组件名]',  // 如 ConstructionDesignApproval
  props,
  setup(props) {
    const { createMessage } = useMessage();
    const { t } = useI18n();
    const approvalFormRef = ref<[REPLACE:IApprovalForm类型名]>();
    const loading = ref(false);
    const templatePermission = ref<string>('');
    const otherOperationType = ref<string>('');
    const loaded = ref(false);
    const primaryKey = ref('');

    const state = reactive<{
      loading: boolean;
      detailData: DetailData;
      templatePermission: string;
      operationType: string;
      otherOperationType: string;
      loaded: boolean;
    }>({
      loading: false,
      detailData: {},
      templatePermission: '',
      operationType: '',
      otherOperationType: '',
      loaded: false,
    });

    // [KEEP] 注入权限
    provide<PermissionData>(ProvideContext.Permission, state);

    onMounted(() => {
      // [NOTE] 推荐在 onMounted 中调用 watch，参考 constructionDesignApproval 模式
      // 如果直接用 watch + immediate 也可以（参考 startApplyApproval）
      init();
    });

    // ---- 初始化 ----
    async function init() {
      state.loading = true;
      try {
        // [REPLACE] businessKey 取法
        // 方式A（工程管理模块通用）：variable.json → businessId
        const _primaryKey = JSON.parse(props.record?.variable.json ?? '{}')?.businessId ?? '';
        // 方式B（老模块通用）：businessKey → primaryKey
        // const _primaryKey = JSON.parse(props.record?.businessKey ?? '{}').primaryKey ?? '';
        primaryKey.value = _primaryKey;
        await loadDetail(_primaryKey);
        state.loaded = true;
        loaded.value = true;
      } catch (error) {
        console.error(error);
        state.loading = false;
      }
    }

    // ---- 权限更新 ----
    const handlePermissionUpdate = (data: { templatePermission: string; otherOperationType: string; operationType: string }) => {
      templatePermission.value = data.templatePermission;
      otherOperationType.value = data.otherOperationType;
      state.templatePermission = data.templatePermission || '';
      state.otherOperationType = data.otherOperationType || '';
      state.operationType = data.operationType || '';
    };

    // ---- 是否驳回重新发起 ----
    // [KEEP] 固定逻辑
    const isRejected = computed(() => {
      return ['submit_save'].includes(templatePermission.value) && props.modalType === 'approve';
    });

    // ---- 加载详情 ----
    const loadDetail = async (id?: string) => {
      if (!id) return;
      try {
        state.loading = true;
        // [REPLACE] 详情 API 调用方式
        // 方式A：getDetail({ id })
        const res = await [REPLACE:详情API函数名]({ id });
        // 方式B：getDetail(id)
        // const res = await [REPLACE:详情API函数名](id);
        // 方式C：解构 { data }
        // const { data } = await [REPLACE:详情API函数名](id);
        if (res?.data) {
          state.detailData = res.data as unknown as DetailData;
        }
      } catch (error) {
        console.error('加载详情数据失败', error);
      } finally {
        state.loading = false;
      }
    };

    // ---- 提交前校验 & 草稿保存 ----
    // [REPLACE] ref 类型根据编辑组件类型调整
    const viewRef = ref<[REPLACE:查看组件Ref类型名]>();
    const editRef = ref<[REPLACE:编辑组件Ref类型名]>();

    const onSubmit = async () => {
      // [KEEP] 驳回重发场景：调用编辑组件的保存方法
      if (isRejected.value) {
        // [REPLACE] 编辑组件 expose 方法名
        return await editRef.value?.[REPLACE:编辑组件expose方法]();
        // 常见方法名：saveDraft / approveSaveDraft / submitReset
      }

      // [REPLACE] 按审批节点校验模板（开始）
      const data = viewRef.value?.getData();
      
      // 节点校验映射表
      const nodeValidations: Record<string, { key: string; label: string; validator?: (v: any) => boolean }[]> = {
        // [REPLACE] 审批节点枚举：[{ key: 'data 中的 key', label: '错误提示', validator?: 自定义校验函数 }]
        // 示例：
        // approve_sjrl: [  // 技术部 - 设计容量录入
        //   { key: 'designCapacity', label: '设计容量' },
        // ],
        // approve_cbcs: [  // 成本部 - 成本测算
        //   { key: 'unitCost', label: '单瓦成本' },
        //   { key: 'similarProjectCost', label: '同类项目成本' },
        // ],
        // approve_ycbp: [  // 财务 BP - 经济信息
        //   { key: 'cumulativeCapacityRate', label: '累计开工容量毛利率' },
        //   { key: 'attachmentList', label: '附件', validator: v => v && v.length > 0 },
        // ],
      };

      const rules = nodeValidations[state.operationType] || [];
      for (const rule of rules) {
        const fieldValue = data?.[rule.key];
        const isValid = rule.validator 
          ? rule.validator(fieldValue)
          : fieldValue != null && fieldValue !== '';
        
        if (!isValid) {
          createMessage.error(`请填写${rule.label}`);
          return Promise.reject();
        }
      }
      // [REPLACE] 按审批节点校验模板（结束）

      // [REPLACE] 草稿保存方式
      // 方式A：独立 API 调用
      // const data = viewRef.value?.getData();
      // await saveApproval(data);
      // return Promise.resolve();
      //
      // 方式B：组件 ref 方法
      // return await editRef.value?.saveDraft();
      //
      // 方式C：无特殊保存逻辑
      return Promise.resolve();
    };

    // ---- 驳回重发回调 ----
    async function onAfterSbumit() {
      // [OPTIONAL] 如果有驳回重发后更新审批状态的需求
      if (isRejected.value && primaryKey.value) {
        // [REPLACE] 驳回重发后调用的 API
        // return await updateStatusToApproving(primaryKey.value);
      }
      return Promise.resolve();
    }

    // [KEEP] 辅助函数
    async function saveApproval(data: any) {
      // [REPLACE] 如果草稿保存用独立 API，替换此处
      // return await saveDraft(data);
    }

    return () => (
      <InnerLayout v-loading={loading.value}>
        <div class="office-approval-wrapper">
          {/* 业务详情模块 */}
          <div class="office-card">
            <div>
              {loaded.value && (
                <>
                  {isRejected.value ? (
                    // [REPLACE] 编辑模式渲染（驳回重发）
                    // 渲染模式A：独立编辑组件
                    <[REPLACE:编辑组件名] ref={editRef} type="edit" id={primaryKey.value} displayMode="embedded" />
                    // 渲染模式B：同一组件 mode=edit
                    // <[REPLACE:组件名] ref={editRef} mode="edit" id={primaryKey.value} displayMode="embedded" />
                    // 渲染模式C：独立内容组件
                    // <[REPLACE:编辑组件名] ref={editRef} id={state.detailData.id} />
                  ) : (
                    // [REPLACE] 查看模式渲染
                    // 渲染模式A：独立 DetailModal 组件
                    <[REPLACE:查看组件名] ref={viewRef} displayMode="embedded" v-model:externalData={state.detailData} />
                    // 渲染模式B：同一组件 mode=view
                    // <[REPLACE:组件名] ref={viewRef} mode="view" id={primaryKey.value} displayMode="embedded" />
                    // 渲染模式C：独立 DetailView（无 ref 交互）
                    // <[REPLACE:查看组件名] data={state.detailData} loading={state.loading} />
                  )}
                </>
              )}
            </div>
            {/* [KEEP] 审批模块 */}
            {props.modalType !== 'approveRecord' && (
              <[REPLACE:ApprovalForm组件名]
                ref={approvalFormRef}
                class="!mt-[10px]"
                record={{
                  ...(props?.record ?? {}),
                  variable: props?.record?.variable,
                }}
                modalType={props.modalType}
                onParentSubmit={onSubmit}
                onAfterSbumit={onAfterSbumit}
                onUpdate:permission={handlePermissionUpdate}
              />
            )}
          </div>
        </div>
      </InnerLayout>
    );
  },
});

export default [REPLACE:组件名];
```

